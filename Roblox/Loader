repeat task.wait() until game:IsLoaded()
repeat task.wait() until game.Players.LocalPlayer

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

repeat task.wait() until workspace:FindFirstChildOfClass("Camera")

task.wait(1)

local DiscordLink = "https://discord.gg/JyMPreZ7"

local SailueatarchiwaScript = "https://raw.githubusercontent.com/MyG100777/Main/refs/heads/main/Roblox/Games/Sailueatarchiwav.lua"
local RedSwordScript = "https://raw.githubusercontent.com/MyG100777/Main/refs/heads/main/Roblox/Games/Rs.lua"

local SupportedGames = {
    ["78520309641318"] = RedSwordScript,
    ["131481383443764"] = SailueatarchiwaScript
}

local scriptUrl = SupportedGames[tostring(game.PlaceId)]

if not scriptUrl then
    LocalPlayer:Kick("❌ Map นี้ยังไม่รองรับ GzusX")
    return
end

pcall(function()
    if setclipboard then
        setclipboard(DiscordLink)
    end
end)

pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification",{
        Title = "GzusX Loader",
        Text = "Loading Script...",
        Duration = 5
    })
end)

local success = false
local tries = 0
local maxTries = 3

while not success and tries < maxTries do
    tries = tries + 1 

    local ok, result = pcall(function()
        return game:HttpGet(scriptUrl)
    end)

    if ok and type(result) == "string" then
        success = true

        local runSuccess, err = pcall(function()
            local loadedFunc, loadErr = loadstring(result)
            if loadedFunc then
                loadedFunc()
            else
                error(loadErr or "loadstring failed (returned nil)")
            end
        end)

        if not runSuccess then
            warn("Script Runtime Error:", err)
            pcall(function()
                game:GetService("StarterGui"):SetCore("SendNotification",{
                    Title = "❌ Script Error",
                    Text = tostring(err),
                    Duration = 15
                })
            end)
        end
    else
        warn("Load attempt "..tries.." failed")
        task.wait(2)
    end
end

if not success then
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification",{
            Title = "❌ Loader Failed",
            Text = "โหลดสคริปไม่สำเร็จ โปรดเช็คเน็ตหรือตัวรันของคุณ",
            Duration = 5
        })
    end)
end
